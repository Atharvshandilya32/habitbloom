{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid"
      }
    },
    "hbIds": {
      "$hbId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
      }
    },
    "socialProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid"
      }
    },
    "friends": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        "$friendUid": {
          ".read": "auth != null",
          ".write": "$uid === auth.uid || $friendUid === auth.uid"
        }
      }
    },
    "friendRequests": {
      ".read": "auth != null",
      "$requestId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "blocked": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "activityFeed": {
      ".read": "auth != null",
      "$activityId": {
        ".write": "auth != null",
        "reactions": {
          "$uid": {
            ".write": "$uid === auth.uid"
          }
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "auth != null"
      }
    },
    "socialChallenges": {
      ".read": "auth != null",
      "$challengeId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "teams": {
      ".read": "auth != null",
      "$teamId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "privacySettings": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid"
      }
    },
    "spaces": {
      ".read": "auth != null",
      "$spaceId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('createdBy').val() === auth.uid)"
      }
    },
    "spaceMembers": {
      ".read": "auth != null",
      "$memberKey": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || newData.child('userId').val() === auth.uid || root.child('spaceMembers').child($memberKey).child('userId').val() === auth.uid || root.child('spaces').child(newData.child('spaceId').val()).child('createdBy').val() === auth.uid)"
      }
    },
    "spaceRoles": {
      "$spaceId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "spaceRosters": {
      "$spaceId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "spaceAuditLogs": {
      "$spaceId": {
        ".read": "auth != null",
        "$logId": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists()"
        }
      }
    },
    "spaceInvites": {
      ".read": "auth != null",
      "$inviteCode": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
