{
  "rules": {
    "activityFeed": {
      ".read": "auth != null",
      "$activityId": {
        ".write": "auth != null && (!data.exists() ? newData.child('authorUid').val() === auth.uid : data.child('authorUid').val() === auth.uid)",
        "reactions": {
          "$uid": {
            ".write": "$uid === auth.uid"
          }
        }
      }
    },
    "blocked": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "friendRequests": {
      ".read": "auth != null && ((query.orderByChild == 'receiverUid' && query.equalTo == auth.uid) || (query.orderByChild == 'senderUid' && query.equalTo == auth.uid))",
      ".indexOn": ["receiverUid", "senderUid"],
      "$requestId": {
        ".read": "auth != null && (data.child('receiverUid').val() === auth.uid || data.child('senderUid').val() === auth.uid)",
        ".write": "auth != null && (!data.exists() ? (newData.child('senderUid').val() === auth.uid || newData.child('receiverUid').val() === auth.uid) : (data.child('senderUid').val() === auth.uid || data.child('receiverUid').val() === auth.uid))"
      }
    },
    "friends": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        "$friendUid": {
          ".read": "auth != null",
          ".write": "$uid === auth.uid || $friendUid === auth.uid"
        }
      }
    },
    "hbIds": {
      "$hbId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "auth != null"
      }
    },
    "privacySettings": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid"
      }
    },
    "socialChallenges": {
      ".read": "auth != null",
      "$challengeId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() ? newData.child('createdBy').val() === auth.uid : (data.child('createdBy').val() === auth.uid || newData.child('participants').exists()))"
      }
    },
    "socialProfiles": {
      ".read": "auth != null",
      ".indexOn": ["totalXP", "currentStreak", "completedHabitsCount", "hbId", "displayName", "username"],
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid"
      }
    },
    "spaceChallenges": {
      "$spaceId": {
        ".read": "auth != null && root.child('spaceMembers').child($spaceId + '_' + auth.uid).exists()",
        ".write": "auth != null && root.child('spaceMembers').child($spaceId + '_' + auth.uid).exists()"
      }
    },
    "spaceAuditLogs": {
      "$spaceId": {
        ".read": "auth != null && (root.child('spaces').child($spaceId).child('createdBy').val() === auth.uid || root.child('spaceMembers').child($spaceId + '_' + auth.uid).child('roleId').val() === 'admin')",
        "$logId": {
          ".read": "auth != null && (root.child('spaces').child($spaceId).child('createdBy').val() === auth.uid || root.child('spaceMembers').child($spaceId + '_' + auth.uid).child('roleId').val() === 'admin')",
          ".write": "auth != null && !data.exists() && root.child('spaceMembers').child($spaceId + '_' + auth.uid).exists()"
        }
      }
    },
    "spaceInvites": {
      ".read": "auth != null && query.orderByChild == 'spaceId' && root.child('spaceMembers').child(query.equalTo + '_' + auth.uid).exists()",
      ".indexOn": ["spaceId"],
      "$inviteCode": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('spaces').child(newData.exists() ? newData.child('spaceId').val() : data.child('spaceId').val()).child('createdBy').val() === auth.uid || root.child('spaceMembers').child((newData.exists() ? newData.child('spaceId').val() : data.child('spaceId').val()) + '_' + auth.uid).child('roleId').val() === 'admin')"
      }
    },
    "spaceMembers": {
      ".read": "auth != null && ((query.orderByChild == 'userId' && query.equalTo == auth.uid) || (query.orderByChild == 'spaceId' && root.child('spaceMembers').child(query.equalTo + '_' + auth.uid).exists()))",
      ".indexOn": ["userId", "spaceId"],
      "$memberKey": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('spaceMembers').child(data.child('spaceId').val() + '_' + auth.uid).exists())",
        ".write": "auth != null && (!data.exists() ? (newData.child('userId').val() === auth.uid && (newData.child('roleId').val() === 'member' || root.child('spaces').child(newData.child('spaceId').val()).child('createdBy').val() === auth.uid)) : (root.child('spaces').child(data.child('spaceId').val()).child('createdBy').val() === auth.uid || root.child('spaceMembers').child(data.child('spaceId').val() + '_' + auth.uid).child('roleId').val() === 'admin' || (data.child('userId').val() === auth.uid && !newData.exists())))"
      }
    },
    "spaceRoles": {
      ".read": "auth != null",
      "$spaceId": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('spaces').child($spaceId).child('createdBy').val() === auth.uid"
      }
    },
    "spaceRosters": {
      "$spaceId": {
        ".read": "auth != null && (root.child('spaces').child($spaceId).child('createdBy').val() === auth.uid || root.child('spaceMembers').child($spaceId + '_' + auth.uid).child('roleId').val() === 'admin')",
        ".write": "auth != null && (root.child('spaces').child($spaceId).child('createdBy').val() === auth.uid || root.child('spaceMembers').child($spaceId + '_' + auth.uid).child('roleId').val() === 'admin')"
      }
    },
    "spaces": {
      "$spaceId": {
        ".read": "auth != null && root.child('spaceMembers').child($spaceId + '_' + auth.uid).exists()",
        "name": { ".read": "auth != null" },
        "description": { ".read": "auth != null" },
        "type": { ".read": "auth != null" },
        "branding": { ".read": "auth != null" },
        "identityConfig": { ".read": "auth != null" },
        ".write": "auth != null && (!data.exists() || data.child('createdBy').val() === auth.uid)"
      }
    },

    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    }
  }
}
