{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid"
      }
    },
    "hbIds": {
      "$hbId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
      }
    },
    "spaces": {
      ".read": "auth != null",
      "$spaceId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('createdBy').val() === auth.uid)"
      }
    },
    "spaceMembers": {
      ".read": "auth != null",
      "$memberKey": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || newData.child('userId').val() === auth.uid || root.child('spaceMembers').child($memberKey).child('userId').val() === auth.uid || root.child('spaces').child(newData.child('spaceId').val()).child('createdBy').val() === auth.uid)"
      }
    },
    "spaceRoles": {
      "$spaceId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "spaceRosters": {
      "$spaceId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "spaceAuditLogs": {
      "$spaceId": {
        ".read": "auth != null",
        "$logId": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists()"
        }
      }
    },
    "spaceInvites": {
      ".read": "auth != null",
      "$inviteCode": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
